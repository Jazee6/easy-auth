{
  "name": "easy-auth",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "og:generate": "bun scripts/generate-og-image.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "auth:generate": "bunx auth@1.7.6 generate --config scripts/auth-schema.config.ts --output src/db/auth-schema.generated.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@bprogress/react": "^1.2.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "1.7.6",
    "bowser": "2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "jose": "6.2.10",
    "miniflare": "5.20260825.0-alpha",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.86.0",
    "shadcn": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  }
}
